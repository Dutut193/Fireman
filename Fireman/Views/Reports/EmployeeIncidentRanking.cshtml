@model IEnumerable<EmployeeIncidentRankingViewModel>

<h2>Employee Incident Ranking (Last Year)</h2>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>#</th>
            <th>Employee</th>
            <th>Incident Count</th>
        </tr>
    </thead>
    <tbody>
        @{
            int index = 1;
        }
        @foreach (var item in Model)
        {
            <tr>
                <td>@index</td>
                <td>@item.EmployeeName</td>
                <td>@item.IncidentCount</td>
            </tr>
            index++;
        }
    </tbody>
</table>
